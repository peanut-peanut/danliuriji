# 只在服务器保存真实值；不要提交实际 AccessKey。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
# 可选：自定义 Bucket 对外访问域名；未设置时 ali-oss 生成临时签名 URL。
OSS_PUBLIC_BASE_URL=

# DeepSeek：仅在服务器的 .env 中配置，绝不要提交真实 Key。
DEEPSEEK_API_KEY=
# 可选，默认 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
# 可选，默认 https://api.deepseek.com/chat/completions
DEEPSEEK_API_BASE_URL=
